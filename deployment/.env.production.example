# ==============================================================================
# KAVACH 6.0 — Production Environment Variables
# Copy to .env or load into container deployment environment
# ==============================================================================

# 1. Domain Configuration
# Enter your fully qualified domain name (e.g. kavach.yourdomain.com)
# Caddy will automatically issue and renew trusted SSL/TLS certificates via Let's Encrypt
KAVACH_DOMAIN=kavach.yourdomain.com

# 2. Production Security Secrets
# Generate a cryptographically secure random string: openssl rand -hex 32
SECRET_KEY=change_this_to_a_strong_64_character_random_secret_in_production
APP_ENV=production
DEBUG=false
REQUIRE_AUTH=true

# 3. PostgreSQL Database Credentials
POSTGRES_DB=kavach_db
POSTGRES_USER=kavach_user
POSTGRES_PASSWORD=kavach_ultra_secure_postgres_pass_2026!
DATABASE_URL=postgresql://kavach_user:kavach_ultra_secure_postgres_pass_2026!@kavach-postgres:5432/kavach_db
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# 4. Production Team Accounts Initial Passwords
# Used to seed initial team accounts on first database startup
KAVACH_ADMIN_PASSWORD=Kavach@Admin2026!
KAVACH_TEAM_PASSWORD=Kavach@Team2026!

# Individual account overrides (optional):
# KAVACH_PASSWORD_ADMIN001=CustomAdminPassword123!
# KAVACH_PASSWORD_TEAM001=CustomTeam1Password123!
# KAVACH_PASSWORD_TEAM002=CustomTeam2Password123!
# KAVACH_PASSWORD_TEAM003=CustomTeam3Password123!
# KAVACH_PASSWORD_TEAM004=CustomTeam4Password123!

# 5. Server-side AI (Ollama)
OLLAMA_URL=http://kavach-ollama:11434
OLLAMA_MODEL=llama3
