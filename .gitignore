.env
.env.*
!.env.example
!.env.production.example

# Local database
kavach.db
*.db
*.sqlite
*.sqlite3

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/

# Python cache/build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs and runtime artifacts
logs/
*.log

# General build/cache artifacts
dist/
build/
.tmp/
.cache/

# Large monolithic documentation snapshots
..KAVACH_COMPLETE_PROJECT.md
INFO/KAVACH_COMPLETE_PROJECT.md

# Pre-compiled USB distributable binaries
KAVACH_USB/*.exe

# Generated assessment export dossiers and forensic reports
reports/

# Unused USB demo fixture
KAVACH_USB/DEMO/

# Legacy monolithic documentation snapshots
legacy/..KAVACH_COMPLETE_PROJECT.md
