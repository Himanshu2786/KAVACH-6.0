# KAVACH Security Assessment Platform — Environment Configuration
# Copy this file to .env to override defaults.

# Ollama Local AI Service (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
AI_TIMEOUT=15.0

# Database Persistence
DATABASE_URL=sqlite:///./kavach.db

# Operational Mode
APP_ENV=development
DEMO_MODE=true
